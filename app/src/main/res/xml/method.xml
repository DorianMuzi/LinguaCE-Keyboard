<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.linguace.keyboard.SetupActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <!-- ce = tchétchène (ISO 639-1). Latin et cyrillique se basculent avec la touche КИР / LAT. -->
    <subtype
        android:imeSubtypeLocale="ce"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_ce"
        android:languageTag="ce" />
</input-method>
